								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{customerToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sourceAccountNumber\": \"1000000001\",\n    \"destinationAccountNumber\": \"1000000002\",\n    \"amount\": 2000000,\n    \"message\": \"Chuyen tien tieu vat hang thang\"\n}"
						},
						"url": {
