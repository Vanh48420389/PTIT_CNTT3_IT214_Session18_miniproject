							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.transactionRef) {",
									"    pm.collectionVariables.set('lastTxnRef', jsonData.data.transactionRef);",
									"}"
